---
/**
 * The whole booking flow on one page:
 *
 *   time → details → done                  (mode="book")
 *   time → note → noted                    (mode="book", when no time works)
 *   overview → time → confirm → done       (mode="manage", from a manage link)
 *
 * A topic is never a step. Picking one is optional: beside the calendar on a
 * wide screen, in the form on a narrow one. The markup for every step is
 * rendered here; src/scripts/booker.ts moves between them and draws the
 * calendar. Without JavaScript the topics still read in full and offer email
 * and LinkedIn.
 */
import { advertising, availability, findRoute, host, meeting, minutesFor, opening, routes, visitorHours } from '../config';
import Sketch from './Sketch.astro';

export type ManageBoot = {
  token: string;
  routeId: string;
  label: string;
  minutes: number;
  start: string;
  end: string;
  meetUrl?: string;
};

interface Props {
  mode: 'book' | 'manage';
  initialRoute?: string;
  manage?: ManageBoot;
}

const { mode, initialRoute, manage } = Astro.props;
const spoiled = (manage?.routeId ?? initialRoute) === advertising.route.id;
const email = spoiled ? advertising.email : host.email;
const linkedin = spoiled ? undefined : host.linkedin;
// A topic's own page (/speaking) renders with that topic already picked.
const initial = mode === 'book' ? findRoute(initialRoute) : undefined;
const firstStep = mode === 'manage' ? 'overview' : 'time';
const manageRoute = findRoute(manage?.routeId);
// Said only for a topic whose length differs from every other conversation's.
const ownLength = (route: (typeof routes)[number]) => minutesFor(route) !== meeting.minutes;

const boot = {
  mode,
  initialRoute: initialRoute ?? null,
  hostTimeZone: availability.timezone,
  visitorHours,
  meeting,
  routes: (spoiled ? [advertising.route] : routes).map((route) => ({
    id: route.id,
    label: route.label,
    response: route.response,
    minutes: minutesFor(route),
    prompt: route.prompt,
    placeholder: route.placeholder,
  })),
  manage: manage ?? null,
  host: { firstName: host.firstName, email },
  // Set in .env.production. Unset in development, which skips the spam check.
  turnstileSiteKey: import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || null,
};

const icon = {
  clock:
    '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  video:
    '<rect x="3" y="6.5" width="12.5" height="11" rx="2.5"/><path d="m15.5 10.5 5-3v9l-5-3"/>',
  globe:
    '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.3 2.4 3.5 5.2 3.5 8.5s-1.2 6.1-3.5 8.5c-2.3-2.4-3.5-5.2-3.5-8.5S9.7 5.9 12 3.5Z"/>',
  calendar:
    '<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/>',
  back: '<path d="M14.5 6 8.5 12l6 6"/>',
  next: '<path d="m9.5 6 6 6-6 6"/>',
};
---

<div class="booker" data-booker data-mode={mode} data-step={firstStep}>
  <script type="application/json" data-boot set:html={JSON.stringify(boot)} />

  <p class="sr-only" role="status" aria-live="polite" data-live></p>

  {
    mode === 'manage' && manage && (
      <section class="step doc" data-step-panel="overview" aria-labelledby="overview-title">
        <h1 id="overview-title" class="doc-h1" tabindex="-1">
          Your conversation with {host.firstName}
        </h1>
        <dl class="facts mt-6" data-overview-facts />
        <div class="mt-8 flex flex-wrap items-center gap-3" data-overview-actions>
          <button type="button" class="btn" data-action="reschedule">
            Reschedule
          </button>
          <button type="button" class="btn-quiet" data-action="ask-cancel">
            Cancel
          </button>
        </div>
        <div class="confirm-cancel mt-8" data-cancel-confirm hidden>
          <p class="font-medium">Cancel this conversation?</p>
          <p class="mt-1 text-muted">You and {host.firstName} will both get a cancellation from Google Calendar.</p>
          <div class="mt-4 flex flex-wrap gap-3">
            <button type="button" class="btn" data-action="cancel">
              Cancel conversation
            </button>
            <button type="button" class="btn-quiet" data-action="keep">
              Keep it
            </button>
          </div>
        </div>
        <p class="mt-6 text-[0.875rem] text-accent" data-overview-error hidden />
      </section>
    )
  }

  <section class="step sheet" data-step-panel="schedule" hidden={mode === 'manage'}>
    <div class="schedule">
      <aside class="summary">
        {
          mode === 'book' && (
            // Who this is and, on a wide screen, the topics beside the calendar.
            // Pressing one is optional and sharpens the question asked at
            // booking. A narrow screen offers the same choice in the form.
            <div class="rail" data-rail>
              <h1 id="rail-title" class="rail-title" tabindex="-1">
                <Sketch type="underline" seed={7} tone="faint" delay={180}>
                  {spoiled ? advertising.title : opening.title}
                </Sketch>
              </h1>
              {spoiled ? (
                <>
                  <p class="rail-lede">A {minutesFor(initial)}-minute Google Meet with {host.name}, founder of {advertising.name}.</p>
                  <p class="rail-lede">{advertising.route.response}</p>
                </>
              ) : (
                <>
                  <p class="rail-lede">{opening.lede}</p>
                  <p class="rail-caption" id="topics-label">{opening.topics}</p>
                  <div class="rail-list" role="group" aria-labelledby="topics-label" data-topics>
                    {routes.map((route) => (
                      <div class="rail-row">
                        <button
                          type="button"
                          class="rail-pick"
                          aria-pressed={initial?.id === route.id ? 'true' : 'false'}
                          aria-describedby={`rail-${route.id}`}
                          data-topic={route.id}
                        >
                          <span class="rail-label">{route.label}</span>
                          {ownLength(route) && <span class="stamp rail-stamp">{minutesFor(route)} min</span>}
                          <svg class="rail-check" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m5 12.5 4.5 4.5L19 7.5" />
                          </svg>
                        </button>
                        <p class="rail-detail" id={`rail-${route.id}`}>
                          {route.response}
                        </p>
                      </div>
                    ))}
                  </div>
                  <noscript>
                    {/* Without the script the toggles would do nothing, so the topics are plain text instead. */}
                    <ul class="rail-static" role="list">
                      {routes.map((route) => (
                        <li class="rail-row">
                          <p class="rail-label">{route.label}</p>
                          <p class="rail-detail">{route.response}</p>
                        </li>
                      ))}
                    </ul>
                  </noscript>
                </>
              )}
              <p class="rail-write">
                Rather write? Email <a class="link" href={`mailto:${email}`}>{email}</a>{linkedin && <> or find me on <a class="link" href={linkedin}>LinkedIn</a></>}.
              </p>
            </div>
          )
        }

        {
          mode === 'manage' && manage && (
            <div class="summary-block">
              <button type="button" class="btn-text -ml-1" data-back>
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon.back} />
                <span>Your conversation</span>
              </button>

              <h1 id="schedule-title" class="doc-h2 mt-5 text-balance" tabindex="-1">{manage.label}</h1>

              <ul class="summary-facts mt-4" role="list">
                <li>
                  <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon.clock} />
                  <span>{manage.minutes} min</span>
                </li>
                <li>
                  <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon.video} />
                  <span>Google Meet</span>
                </li>
                <li class="is-chosen" data-summary-when hidden>
                  <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon.calendar} />
                  <span data-summary-when-text></span>
                </li>
                <li data-summary-was>
                  <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon.calendar} />
                  <span><s data-summary-was-text></s></span>
                </li>
              </ul>

              {manageRoute && <p class="summary-response mt-5 text-pretty text-[0.875rem] text-muted">{manageRoute.response}</p>}
            </div>
          )
        }
      </aside>

      <div class="pane" data-pane="time">
        <h2 class="pane-title">Pick a day and time</h2>

        {/* Whose clock the times are on, and which hours of it. booker.ts writes the sentence around the picker. */}
        <div class="fit" data-fit>
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon.globe} />
          <div class="fit-body">
            <p class="fit-text">
              <span data-fit-before></span><span class="fit-zone"
                ><span data-zone-label></span><select class="fit-zone-select" data-tz aria-label="Time zone"></select></span
              ><span data-fit-after></span>
            </p>
            <div class="fit-actions" data-fit-actions hidden>
              <button type="button" class="link" data-hours-toggle hidden></button>
              {mode === 'book' && !spoiled && <button type="button" class="btn" data-open-note data-note-primary hidden>Send me a note</button>}
            </div>
            <p class="fit-correction" data-fit-correction hidden>
              <span data-fit-suggest></span>
              <button type="button" class="link" data-fit-use>Switch</button>
            </p>
          </div>
        </div>

        <div class="picker" data-picker>
          <div class="calendar" data-calendar>
            <div class="cal-head">
              <p class="cal-month" data-month-label aria-live="polite"></p>
              <div class="flex gap-1">
                <button type="button" class="cal-nav" data-month="-1" aria-label="Previous month">
                  <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon.back} />
                </button>
                <button type="button" class="cal-nav" data-month="1" aria-label="Next month">
                  <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon.next} />
                </button>
              </div>
            </div>
            <div class="cal-weekdays" aria-hidden="true">
              <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
            </div>
            <div class="cal-grid" data-days role="group" aria-label="Days"></div>
            <p class="cal-note" data-cal-note></p>
          </div>

          <div class="times" data-times>
            <p class="times-day" data-times-day></p>
            <ul class="times-list" role="list" data-times-list></ul>
            <p class="times-empty" data-times-empty>Pick a day to see open times.</p>
            <p class="times-more" data-times-more hidden>
              <span data-times-more-text></span>
              <button type="button" class="link" data-hours-toggle-day>Show all times</button>
            </p>
          </div>
        </div>

        {
          mode === 'book' && !spoiled && (
            <p class="note-line" data-note-line hidden>
              None of these work?
              <button type="button" class="link" data-open-note>
                Send me a note
              </button>
            </p>
          )
        }

        {
          mode === 'book' && (
            // A narrow screen has no rail, so the other ways to reach Pavel go here.
            <p class="pane-write">
              Rather write? Email <a class="link" href={`mailto:${email}`}>{email}</a>{linkedin && <> or find me on <a class="link" href={linkedin}>LinkedIn</a></>}.
            </p>
          )
        }
      </div>

      {
        mode === 'book' && (
          <form class="pane" data-pane="details" hidden novalidate>
            <h2 class="pane-title" tabindex="-1">Your details</h2>
            <div class="when" data-when>
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon.calendar} />
              <p>
                <span class="when-time" data-when-text></span>
                <span class="when-sub" data-when-sub></span>
                <button type="button" class="link when-change" data-change-time>Change time</button>
              </p>
            </div>
            <div class="space-y-5">
              <div>
                <label class="field-label" for="f-name">Name</label>
                <input class="field" id="f-name" name="name" autocomplete="name" required maxlength="100" />
              </div>
              <div>
                <label class="field-label" for="f-email">Email</label>
                <input class="field" id="f-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="254" />
                <p class="mt-1.5 text-[0.8125rem] text-muted">The calendar invite and Meet link go here.</p>
              </div>
              {/* Narrow screens only: on a wide one the rail beside the form is this choice. */}
              {!spoiled && <div class="topic-field">
                <label class="field-label" for="f-topic">
                  Topic <span class="font-normal text-muted">Optional</span>
                </label>
                <select class="field" id="f-topic" data-topic-select>
                  <option value="">Pick one if it helps</option>
                  {routes.map((route) => (
                    <option value={route.id} selected={initial?.id === route.id}>
                      {route.label}
                    </option>
                  ))}
                </select>
                <p class="topic-hint" data-topic-hint hidden={!initial}>
                  {initial?.response}
                </p>
              </div>}
              <div>
                <label class="field-label" for="f-note">
                  <span data-prompt>{initial?.prompt ?? meeting.prompt}</span>
                  <span class="font-normal text-muted">Optional</span>
                </label>
                <textarea
                  class="field"
                  id="f-note"
                  name="note"
                  rows="4"
                  maxlength="1500"
                  placeholder={initial?.placeholder ?? meeting.placeholder}
                  data-note
                />
              </div>
              <div class="hp" aria-hidden="true">
                <label for="f-website">Leave this empty</label>
                <input id="f-website" name="website" tabindex="-1" autocomplete="off" />
              </div>
            </div>
            <div class="turnstile" data-turnstile />
            <p class="form-error" role="alert" data-form-error hidden />
            <div class="mt-7 flex flex-wrap items-center gap-4">
              <button type="submit" class="btn" data-submit>
                Book this time
              </button>
              <p class="text-[0.8125rem] text-muted">
                Your name, email, and note go only into {host.firstName}’s calendar.
                <a class="link" href="/privacy" target={spoiled ? '_blank' : undefined} rel={spoiled ? 'noopener' : undefined}>Privacy</a>
              </p>
            </div>
          </form>
        )
      }

      {
        mode === 'book' && !spoiled && (
          // For a visitor none of the times suit: a note to Pavel's inbox instead of a booking.
          <form class="pane" data-pane="note" hidden novalidate>
            <h2 class="pane-title" tabindex="-1">Send me a note</h2>
            <p class="note-lede">Tell me what would work for you, and I’ll reply by email.</p>
            <div class="space-y-5">
              <div>
                <label class="field-label" for="n-name">Name</label>
                <input class="field" id="n-name" name="name" autocomplete="name" required maxlength="100" />
              </div>
              <div>
                <label class="field-label" for="n-email">Email</label>
                <input class="field" id="n-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="254" />
                <p class="mt-1.5 text-[0.8125rem] text-muted">I’ll reply here.</p>
              </div>
              <div>
                <label class="field-label" for="n-text">What would work for you?</label>
                <textarea class="field" id="n-text" name="text" rows="4" required maxlength="2000" placeholder="Days and times that suit you, or anything else I should know." />
              </div>
              <div class="hp" aria-hidden="true">
                <label for="n-website">Leave this empty</label>
                <input id="n-website" name="website" tabindex="-1" autocomplete="off" />
              </div>
            </div>
            <div class="turnstile" data-turnstile-note />
            <p class="form-error" role="alert" data-note-error hidden />
            <div class="mt-7 flex flex-wrap items-center gap-4">
              <button type="submit" class="btn" data-note-submit>
                Send note
              </button>
              <button type="button" class="btn-quiet" data-note-back>
                Back to the times
              </button>
            </div>
            <p class="mt-4 text-[0.8125rem] text-muted">
              Your note goes only to {host.firstName}’s inbox.
              <a class="link" href="/privacy">Privacy</a>
            </p>
          </form>
        )
      }

      {
        mode === 'book' && !spoiled && (
          <div class="pane" data-pane="noted" hidden>
            <h2 class="pane-title" tabindex="-1">
              Sent
            </h2>
            <p class="note-lede" data-noted-text />
            <button type="button" class="btn-quiet mt-6" data-note-back>
              Back to the times
            </button>
          </div>
        )
      }

      {
        mode === 'manage' && (
          <div class="pane" data-pane="confirm" hidden>
            <h2 class="pane-title">Move your conversation</h2>
            <p class="text-muted">
              Google Calendar will send you and {host.firstName} the updated invite. The Meet link stays the same.
            </p>
            <p class="form-error" role="alert" data-form-error hidden />
            <div class="mt-7 flex flex-wrap gap-3">
              <button type="button" class="btn" data-action="confirm-reschedule">
                Reschedule
              </button>
              <button type="button" class="btn-quiet" data-action="back-to-time">
                Pick another time
              </button>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <section class="step doc" data-step-panel="done" hidden aria-labelledby="done-title">
    <div class="done">
      <div class="done-date" data-done-date aria-hidden="true"></div>
      <div>
        <h1 id="done-title" class="doc-h1" tabindex="-1" data-done-title></h1>
        <p class="mt-2 text-pretty text-muted" data-done-lede></p>
      </div>
    </div>
    <dl class="facts mt-8" data-done-facts></dl>
    <p class="mt-8 text-[0.875rem] text-muted" data-done-footer></p>
  </section>

  <section class="step doc" data-step-panel="cancelled" hidden aria-labelledby="cancelled-title">
    <h1 id="cancelled-title" class="doc-h1" tabindex="-1">Cancelled</h1>
    <p class="mt-3 text-muted">
      Google Calendar is letting you both know. If you want to talk another time,
      <a class="link" href={spoiled ? `/${advertising.route.id}` : '/'}>pick a new time</a>.
    </p>
  </section>

  <noscript>
    {/* Without the script there is no calendar: the topics read in full, at every width, and email is the way in. */}
    <style is:inline>
      .booker[data-booker] [data-pane] {
        display: none !important;
      }
      .booker[data-booker] .schedule {
        display: block !important;
      }
      .booker[data-booker] .summary {
        padding: 0 !important;
        border: 0 !important;
      }
      .booker[data-booker] [data-topics],
      .booker[data-booker] .rail-write {
        display: none !important;
      }
      .booker[data-booker] .rail-caption,
      .booker[data-booker] .rail-static {
        display: block !important;
      }
    </style>
    <div class="sheet mt-8">
      <p class="text-muted">
        Picking a time needs JavaScript. You can email <a class="link" href={`mailto:${email}`}>{email}</a>{linkedin && <> or find me on <a class="link" href={linkedin}>LinkedIn</a></>} instead.
      </p>
    </div>
  </noscript>
</div>

<script>
  import '../scripts/booker';
</script>

<style is:global>
  /* ---- Schedule sheet ------------------------------------------------
     Two panes split by one rule, like a spread in a notebook. The left side
     stays put while the right side changes. A booking starts here, on the
     calendar, at every width.
  */
  .schedule {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 860px) {
    .schedule {
      grid-template-columns: 16.5rem minmax(0, 1fr);
      gap: 0;
    }

    .summary {
      padding-right: 2.25rem;
      border-right: 1px solid var(--rule);
    }

    .pane {
      padding-left: 2.75rem;
    }

    .topic-field,
    .pane-write {
      display: none;
    }
  }

  @media (max-width: 859px) {
    [data-mode='manage'] .summary {
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--rule);
    }

    /* Only who this is; the topics are offered in the form. */
    .summary-response,
    .rail-caption,
    .rail-list,
    .rail-write {
      display: none;
    }

    /* Past the calendar the form needs the room, and its own title says what it is.
       The page's heading stays for screen readers. */
    [data-mode='book']:not([data-step='time']) .summary {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    [data-mode='manage'] .pane-title,
    [data-mode='book'][data-step='time'] .pane-title {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .rail-title {
      font-size: 1.75rem;
    }
  }

  /* ---- Rail: who this is, and the topics beside the calendar ------------ */

  .rail-title {
    font-size: 1.625rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .rail-lede {
    margin-top: 1.125rem;
    font-size: 0.9375rem;
    color: var(--muted);
    text-wrap: pretty;
  }

  .rail-caption {
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .rail-list {
    border-top: 1px solid var(--rule);
  }

  .rail-row {
    border-bottom: 1px solid var(--rule);
  }

  .rail-pick {
    position: relative;
    display: flex;
    width: 100%;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 0.75rem 0;
    text-align: left;
  }

  .rail-pick::before {
    content: '';
    position: absolute;
    inset: 2px -10px;
    z-index: -1;
    border-radius: 6px;
    background: var(--wash);
    opacity: 0;
    transition: opacity 200ms theme('transitionTimingFunction.doc');
  }

  .rail-pick:hover::before {
    opacity: 1;
  }

  .rail-label {
    flex: 1;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.35;
  }

  .rail-stamp {
    margin-top: 0.2rem;
  }

  /* A pressed topic says so with a check as well as color, and pressing it again clears it. */
  .rail-check {
    flex: none;
    width: 1rem;
    height: 1rem;
    margin-top: 0.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    visibility: hidden;
  }

  .rail-pick[aria-pressed='true'] {
    color: var(--accent);
  }

  .rail-pick[aria-pressed='true'] .rail-check {
    visibility: visible;
  }

  .rail-detail {
    display: none;
    padding-bottom: 0.875rem;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--muted);
    text-wrap: pretty;
  }

  .rail-row:has([aria-pressed='true']) .rail-detail {
    display: block;
  }

  .rail-static {
    border-top: 1px solid var(--rule);
  }

  .rail-static .rail-label {
