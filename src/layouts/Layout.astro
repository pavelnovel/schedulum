---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { host, type SpoiledBookingPage } from '../config';

interface Props {
  title: string;
  description?: string;
  path?: string;
  robots?: string;
  spoiled?: SpoiledBookingPage;
}

const {
  title,
  description = `Book a conversation with ${host.name}.`,
  path = '/',
  robots,
  spoiled,
} = Astro.props;
const canonical = new URL(path, Astro.site ?? 'https://meet.pavelnovel.com').href;
const brand = spoiled ?? host;
const icon = spoiled ? 'https://spoilednyc.com/favicon/icon-32x32.png' : '/favicon.svg';
---

<!doctype html>
<html lang="en" data-brand={spoiled ? 'spoiled' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type={spoiled ? 'image/png' : 'image/svg+xml'} href={icon} />

    <noscript>
      <style>
        .needs-js,
        #theme-toggle {
          display: none !important;
        }
        .sketch {
          clip-path: none !important;
        }
      </style>
    </noscript>

    {/* Resolve the theme before first paint so there is no flash. */}
    <script is:inline>
      (function () {
        if (document.documentElement.dataset.brand === 'spoiled' && window.parent !== window) {
          document.documentElement.setAttribute('data-embedded', '');
          return;
        }
        try {
          var stored = localStorage.getItem('theme');
          var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (dark) document.documentElement.setAttribute('data-theme', 'dark');
        } catch (e) {
          /* storage blocked: light default */
        }
      })();
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-accent focus:px-3 focus:py-2 focus:text-xs focus:text-white"
    >
      Skip to content
    </a>
    <header class="site-header sheet flex items-center justify-between pt-6 sm:pt-8">
      <a
        href={brand.site}
        class="group inline-flex min-h-[44px] items-center gap-2.5 rounded-[6px] text-[0.875rem] font-medium text-muted transition-colors hover:text-text"
      >
        <img src={icon} alt="" width="20" height="20" class="rounded-[4px]" />
        {brand.name}
      </a>
      <ThemeToggle />
    </header>

    <main id="main" class="site-main pb-24 pt-10 sm:pt-16">
      <slot />
    </main>
  </body>
</html>

<script>
  const main = document.getElementById('main');
  if (main && document.documentElement.hasAttribute('data-embedded')) {
    const reportHeight = () => {
      window.parent.postMessage({ type: 'schedulum:height', height: main.getBoundingClientRect().height }, '*');
    };
    new ResizeObserver(reportHeight).observe(main);
    window.addEventListener('message', (event) => {
      if (event.source === window.parent && event.data?.type === 'schedulum:measure') reportHeight();
    });
  }
</script>
